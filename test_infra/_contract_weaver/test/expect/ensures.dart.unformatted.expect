import 'contracts.dart';

class Calculator {
  @Ensures('result >= 0')
  int abs(int x) { int? $result; var $threw = false; try {  
    if (x < 0) return $result = -x;
    return $result = x;
   } catch (_) { $threw = true; rethrow; } finally { if (!$threw) { final result = $result as int; if (!Contracts.checking) { Contracts.checking = true; try { if (!(result >= 0)) throw ContractViolation('Postcondition failed: result >= 0'); } finally { Contracts.checking = false; } } } } }

  @Ensures('result.length == count')
  List<int> zeros(int count) { return ((List<int> result) { if (!Contracts.checking) { Contracts.checking = true; try { if (!(result.length == count)) throw ContractViolation('Postcondition failed: result.length == count'); } finally { Contracts.checking = false; } } return result; })(List.filled(count, 0)); }
}
