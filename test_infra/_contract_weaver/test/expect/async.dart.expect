import 'contracts.dart';

class Loader {
  @Requires('path.isNotEmpty')
  @Ensures('result.isNotEmpty')
  Future<String> load(String path) async {
    if (!Contracts.checking) {
      Contracts.checking = true;
      try {
        if (!(path.isNotEmpty))
          throw ContractViolation('Precondition failed: path.isNotEmpty');
      } finally {
        Contracts.checking = false;
      }
    }
    String? $result;
    var $threw = false;
    try {
      await Future<void>.delayed(Duration.zero);
      return $result = await Future<String>.value('contents of $path');
    } catch (_) {
      $threw = true;
      rethrow;
    } finally {
      if (!$threw) {
        final result = $result as String;
        if (!Contracts.checking) {
          Contracts.checking = true;
          try {
            if (!(result.isNotEmpty))
              throw ContractViolation(
                'Postcondition failed: result.isNotEmpty',
              );
          } finally {
            Contracts.checking = false;
          }
        }
      }
    }
  }
}

class Saver {
  bool saved = false;

  @Ensures('saved')
  Future<void> save() async {
    var $threw = false;
    try {
      await Future<void>.delayed(Duration.zero);
      saved = true;
    } catch (_) {
      $threw = true;
      rethrow;
    } finally {
      if (!$threw) {
        if (!Contracts.checking) {
          Contracts.checking = true;
          try {
            if (!(saved))
              throw ContractViolation('Postcondition failed: saved');
          } finally {
            Contracts.checking = false;
          }
        }
      }
    }
  }

  @Ensures('saved')
  Future<void> saveVia() async {
    await save();
    if (!Contracts.checking) {
      Contracts.checking = true;
      try {
        if (!(saved)) throw ContractViolation('Postcondition failed: saved');
      } finally {
        Contracts.checking = false;
      }
    }
  }
}
